# Environment configuration template for tgbot_vpn.
# Copy to `.env` and fill in real values. Never commit `.env`.

# --- Required ---
BOT_TOKEN=123456:replace-with-your-bot-token
VPN_TOKEN=replace-with-your-3x-ui-api-token
DOMAIN=https://panel.example.com:2053/
SUB_URL_BASE=https://panel.example.com:2053/sub/
INBOUND_ID=1

# --- Access / roles ---
# Accepts a JSON list or a comma-separated list. At least one owner is required.
OWNER_IDS=[123456789]
# Legacy alias for OWNER_IDS (deprecated). Used only if OWNER_IDS is empty.
ADMIN_IDS=

# --- Infrastructure ---
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
TIMEZONE=UTC
# Local hour (in TIMEZONE) at which the daily digest is sent.
DIGEST_HOUR=9
LOG_LEVEL=INFO
# Import legacy panel clients / banned list on first start when the DB is empty.
AUTO_IMPORT_LEGACY=false

# --- Legacy seed sources (the DB settings table becomes authoritative later) ---
BANK_ACCOUNT_DETAILS=replace-with-payment-details
BANNED_USERS_FILE=banned_users.json
